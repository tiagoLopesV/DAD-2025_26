FROM oven/bun:1 AS build-stage
WORKDIR /app

COPY package.json  ./
RUN bun install

RUN bun remove esbuild || true
RUN bun add -d esbuild@0.25.12

COPY . .
RUN bun run build

FROM nginx:alpine
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80